{
  "name": "doto",
  "productName": "Doto",
  "version": "0.3.0-b",
  "private": true,
  "description": "A modular desktop notepad with a floating to-do window, images and video embeds.",
  "main": "./out/main/index.js",
  "author": "Krish",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "pack": "npm run build && electron-builder --win portable",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/extension-font-family": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-youtube": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "docx": "^9.13.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-rnd": "^10.5.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.kuremi.doto",
    "productName": "Doto",
    "executableName": "Doto",
    "copyright": "Copyright Krish",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "resources/icon.ico",
      "artifactName": "Doto-0.3b-portable.exe"
    }
  }
}
